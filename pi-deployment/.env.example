# Docker Image
API_IMAGE=your_registry

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=docker
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Database Configuration
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Temporal Configuration
TEMPORAL_NAMESPACE=letsgogolfing

# AWS SES Configuration
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_FROM_EMAIL=your_email@example.com
AWS_FROM_NAME=Your Name

# BrowserBase Configuration
BB_API_KEY=your_browserbase_api_key
BB_EMAIL=your_email@example.com
BB_PASSWORD=your_browserbase_password
BB_PROJECT_ID=your_project_id

# Stripe Configuration
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Pi Configuration (auto-detected by deploy.sh)
PI_IP=pi_ip

# Docker Optimization
COMPOSE_PARALLEL_LIMIT=2
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
