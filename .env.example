# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=docker

# Database Configuration
# Update these values to match your shared PostgreSQL instance
DATABASE_URL=jdbc:postgresql://postgresql:5432/letsgogolfing
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Hibernate DDL mode: validate, update, create, create-drop
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# CORS Configuration
# Add your frontend URLs separated by commas
CORS_ALLOWORIGINS=http://localhost:3000,http://localhost:5173

# Temporal Configuration
# Points to shared Temporal server on shared-infra network
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=letsgogolfing

# AWS SES Configuration
# Used for sending emails
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_FROM_EMAIL=your_email@example.com
AWS_FROM_NAME=Your Name

# BrowserBase Configuration
# Used for browser automation (GolfNow scraping)
BB_API_KEY=your_browserbase_api_key_here
BB_EMAIL=your_email@example.com
BB_PASSWORD=your_browserbase_password_here
BB_PROJECT_ID=your_browserbase_project_id_here

# Stripe Configuration
# Webhook secret for verifying Stripe events
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# JVM Configuration
# Memory settings for Raspberry Pi
JAVA_OPTS=-Xmx512m
